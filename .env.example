# Copy to .env.local and fill in. See README → "Accounts & gift links".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Any long random string; Vercel Cron sends it to /api/cron/expire.
CRON_SECRET=
# Razorpay (Dashboard → Account & Settings → API Keys). Leave blank to publish gifts free.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay → Webhooks → the secret you set for https://tynitales.com/api/payments/webhook (event: order.paid)
RAZORPAY_WEBHOOK_SECRET=
# Google Cloud → Google Auth Platform → Clients → your Web client → Client ID. Turns on Google’s own sign-in popup.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
