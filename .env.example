# Copy to .env.local and fill in. See README → "Accounts & gift links".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Any long random string; Vercel Cron sends it to /api/cron/expire.
CRON_SECRET=
# Razorpay (Dashboard → Account & Settings → API Keys). Leave blank to publish gifts free.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
